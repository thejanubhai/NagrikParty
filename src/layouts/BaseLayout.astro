---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/native.css";
import Logo from "@/components/Logo.astro";
import { SmartIsland } from "@/components/SmartIsland";
import { BottomNav } from "@/components/BottomNav";
import { InstallPrompt } from "@/components/InstallPrompt";
import { HelpButton } from "@/components/HelpButton";
import { FoundingProgressBar } from "@/components/FoundingProgressBar";
import { footerSections } from "@/lib/navigation";
import { getFormationProgress } from "@/lib/progress-service";

const {
  title = "Nagrik Party | Formation Phase",
  description = "An independent political initiative working toward the formation and registration of a political party under Section 29A RPA 1951.",
  bodyClass = "",
} = Astro.props;

const isAdminHost = Astro.url.hostname.replace(/^www\./, "").toLowerCase() === "administration.nagrik.party";
const progressData = await getFormationProgress();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Nagrik Party" />
    <meta name="application-name" content="Nagrik Party" />
    <link rel="icon" type="image/svg+xml" href="/nagrikpartylogo.svg" />
    <link rel="apple-touch-icon" href="/nagrikpartylogo.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph / Social Media (official logo PNG = discovery-safe) -->
    <meta property="og:site_name" content="Nagrik Party" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/brand/logo.png", Astro.url).href} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Nagrik Party: official logo" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/brand/logo.png", Astro.url).href} />
    <meta name="twitter:image:alt" content="Nagrik Party: official logo" />

    <!-- Fonts fully self-hosted (see global.css @font-face) -->
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/Mukta-Devanagari-400.woff2" as="font" type="font/woff2" crossorigin>
    <title>{title}</title>
    {isAdminHost && <meta name="robots" content="noindex, nofollow" />}
    <ClientRouter />
    <script is:inline>
      // Theme: apply saved preference before paint (no flash)
      (function () {
        var t = localStorage.getItem("nagrik-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.dataset.theme = t;
        }
      })();
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Seedha content par jayein</a>
    <div class="site-shell">
      <div class="nav-wrapper">
        <header class="nav">
          <div class="nav-inner">
            <a class="brand" href="/" aria-label="Nagrik Party Home">
              <Logo height={38} className="brand-logo" />
              <div class="brand-word">
                <span class="brand-word-title">Nagrik Party</span>
                <small>Formation Phase</small>
              </div>
            </a>
            <SmartIsland client:load />
          </div>
        </header>
        <FoundingProgressBar client:load initialData={progressData} />
      </div>
      <main id="main-content">
        <slot />
      </main>
      <BottomNav client:load />
      <InstallPrompt client:load />
      <HelpButton client:load />
      <footer class="footer">
        <div class="container footer-grid">
          <div>
            <a class="brand footer-brand" href="/" aria-label="Nagrik Party Home">
              <Logo height={42} className="brand-logo footer-logo" />
              <div class="brand-word">
                <span class="brand-word-title">Nagrik Party</span>
                <small>PHASE 1 · FORMATION PHASE</small>
              </div>
            </a>
            <p style="margin: 14px 0; color: var(--muted); font-size: 13.5px; line-height: 1.55; max-width: 400px;">
              Nagrik Party (Formation Phase): An independent political initiative working toward the formation and registration of a political party under Section 29A RPA 1951. Kaam dikhna chahiye.
            </p>
            <small style="display: block; color: var(--ink-faint); font-size: 11.5px; line-height: 1.5;">
              © 2026 Nagrik Party. Formation Phase (Proposed for registration under Section 29A RPA 1951). Membership cards and Nagrik IDs are organisational records, not government-issued documents.
            </small>
          </div>
          <div class="footer-links">
            {footerSections.map((section) => (
              <div>
                <strong>{section.title}</strong>
                {section.items.map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
