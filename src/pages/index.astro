---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FOUNDER_DATA } from "@/lib/founder";
import { getFormationProgress } from "@/lib/progress-service";
import { OnboardingCarousel } from "@/components/OnboardingCarousel";
import { ShareButton } from "@/components/ShareButton";
import {
  CheckCircle2,
  ArrowRight,
  ShieldAlert,
  TrendingUp,
  AlertCircle,
} from "lucide-react";

export const prerender = false;

const progressData = await getFormationProgress();
---

<BaseLayout
  title="Nagrik Party | Formation Phase | Kaam dikhna chahiye"
  description="A political party is being built. Nagrik Party is an independent political initiative working toward formation and registration under Section 29A RPA 1951."
>
  <!-- =========================================================================
       SECTION 1: HERO VIEWPORT
       ========================================================================= -->
  <section class="page-hero" style="padding-bottom: 48px; border-bottom: 1px solid var(--line-strong); background: var(--paper-card);">
    <div class="container">
      
      <!-- Onboarding (first visit only) -->
      <OnboardingCarousel client:load />

      <!-- Small Phase Label -->
      <div style="margin-bottom: 14px;">
        <span class="founding-progress-badge" style="font-size: 11px; padding: 4px 10px;">
          PHASE 1 · FORMATION PHASE
        </span>
      </div>

      <div class="hero-layout">
        <div>
          <h1 class="hero-title">
            Delhi ki apni party ban rahi hai.
          </h1>

          <div class="hero-subtitle">
            Nagrik Party
          </div>

          <div class="hero-tagline-pill">
            <span class="hero-tagline-main">
              Kaam dikhna chahiye.
            </span>
            <span class="hero-tagline-sub">
              · Work must be visible
            </span>
          </div>

          <p class="hero-body">
            Nagrik Party (Formation Phase): Section 29A RPA 1951 ke tahat registration ki taraf badhta hua ek swatantra rajneetik abhiyaan. Asli saboot, 100% cashless hisaab, aur seedhi nagrik bhagidaari. Sab kuch khula, sab kuch verified.
          </p>

          <!-- Primary, Secondary, Tertiary Actions -->
          <div class="hero-cta-group">
            <a href="/membership" class="button button-primary" style="min-height: 56px; font-size: 17px;">
              Member Banein &rarr;
            </a>
            <a href="/verify/member" class="button" style="min-height: 56px;">
              Card Verify Karein
            </a>
            <a href="#explore" class="button" style="color: var(--muted); min-height: 56px;">
              Aur Dekhein
            </a>
          </div>
        </div>

        <!-- Live Formation Snapshot Box (Stacks on mobile below hero text) -->
        <div class="hero-formation-card">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; gap: 8px;">
            <span style="font-size: 11px; font-weight: 700; color: var(--saffron); text-transform: uppercase; letter-spacing: 0.06em; font-family: var(--font-mono);">
              Formation Status
            </span>
            <span class="founding-progress-badge">
              {progressData.percentage}% Completed
            </span>
          </div>

          <h2 style="font-size: 18px; font-weight: 800; color: var(--ink); margin: 0 0 8px; font-family: var(--font-serif);">
            Building the Foundation
          </h2>
          <p style="font-size: 13.5px; color: var(--muted); line-height: 1.55; margin: 0 0 18px;">
            Building the founding voter network across Delhi to fulfill statutory criteria under Section 29A RPA 1951.
          </p>

          <div style="border-top: 1px solid var(--line); padding-top: 14px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 12.5px; font-weight: 600; color: var(--ink);">
              9-Stage Process
            </span>
            <a href="/formation-progress" style="font-size: 13px; font-weight: 700; color: var(--saffron); text-decoration: none;">
              Track Roadmap &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: FOUNDER INTRODUCTION & PHOTO
       ========================================================================= -->
  <section class="section" style="background: var(--paper); border-bottom: 1px solid var(--line);">
    <div class="container">
      <div class="founder-card-layout">
        <div class="founder-card-image-wrap">
          <img
            src={FOUNDER_DATA.imageSlot}
            alt="Sheikh Arsalanullah Chishti"
            class="founder-card-image"
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null; this.src='/nagrikpartylogo.svg'; this.style.padding='18px';"
          />
        </div>

        <div>
          <div class="section-eyebrow">
            FOUNDER & FOUNDING CONVENER
          </div>
          <h2 style="font-size: clamp(20px, 3.2vw, 26px); font-weight: 700; margin: 0 0 6px; font-family: var(--font-serif); color: var(--ink);">
            {FOUNDER_DATA.legalName}
          </h2>
          <div style="font-size: 13.5px; color: var(--saffron); font-weight: 600; margin-bottom: 10px;">
            Known in public work as {FOUNDER_DATA.publicName}
          </div>
          <p style="font-size: 14.5px; color: var(--ink-body); line-height: 1.6; margin: 0 0 16px;">
            Contested the 2025 Delhi Assembly election independently. Initiating the formation of Nagrik Party to build a durable, accountable citizen-led political organization.
          </p>
          <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
            <a href="/founder" style="font-size: 13.5px; font-weight: 600; color: var(--saffron); text-decoration: none; min-height: 38px; display: inline-flex; align-items: center;">
              Read Full Founder Profile &rarr;
            </a>
            <span style="font-size: 13px; color: var(--muted);">·</span>
            <a href="/why-nagrik" style="font-size: 13.5px; font-weight: 600; color: var(--ink); text-decoration: none; min-height: 38px; display: inline-flex; align-items: center;">
              The Founding Story &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: TWO PRIMARY ENTRY PATHS
       ========================================================================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" style="margin-bottom: 28px; text-align: center;">
        <div class="section-eyebrow">Take Part</div>
        <h2 class="section-title">
          How do you want to participate?
        </h2>
        <p class="section-desc" style="margin: 0 auto;">
          Choose your level of involvement in building Nagrik Party.
        </p>
      </div>

      <div class="cards-grid-3">
        
        <!-- Path 1: Member -->
        <a
          href="/membership"
          class="card"
          style="background: var(--paper-card); border: 2px solid var(--saffron); border-radius: 4px; padding: clamp(22px, 3vw, 32px); text-decoration: none; color: inherit; box-shadow: var(--shadow-elevated); display: flex; flex-direction: column; justify-content: space-between;"
        >
          <div>
            <span class="section-eyebrow" style="color: var(--saffron);">
              PRIMARY PATH
            </span>
            <h3 style="font-size: 20px; font-weight: 800; margin: 8px 0 10px; font-family: var(--font-serif); color: var(--ink);">
              Become a Member
            </h3>
            <p style="font-size: 14.5px; color: var(--muted); line-height: 1.55; margin: 0 0 20px;">
              "I want to formally join Nagrik Party."
              Complete the digital induction, verify your voter details, and receive your organizational Nagrik ID record.
            </p>
          </div>
          <div class="button button-primary" style="width: 100%; justify-content: center; min-height: 44px;">
            Join as Founding Member <ArrowRight size={16} />
          </div>
        </a>

        <!-- Path 2: Volunteer -->
        <a
          href="/volunteer"
          class="card"
          style="background: var(--paper-card); border: 1px solid var(--line-strong); border-radius: 4px; padding: clamp(22px, 3vw, 32px); text-decoration: none; color: inherit; box-shadow: var(--shadow); display: flex; flex-direction: column; justify-content: space-between;"
        >
          <div>
            <span class="section-eyebrow" style="color: var(--green);">
              ACTION PATH
            </span>
            <h3 style="font-size: 20px; font-weight: 800; margin: 8px 0 10px; font-family: var(--font-serif); color: var(--ink);">
              Become a Volunteer
            </h3>
            <p style="font-size: 14.5px; color: var(--muted); line-height: 1.55; margin: 0 0 20px;">
              "I want to contribute my time or skills."
              Help with constituency ground checks, research, design, software, video, or community outreach.
            </p>
          </div>
          <div class="button" style="width: 100%; justify-content: center; min-height: 44px; color: var(--green); border-color: var(--green);">
            Join as Volunteer <ArrowRight size={16} />
          </div>
        </a>

        <!-- Path 3: Explore -->
        <a
          href="/explore"
          class="card"
          style="background: var(--paper-subtle); border: 1px solid var(--line); border-radius: 4px; padding: clamp(22px, 3vw, 32px); text-decoration: none; color: inherit; box-shadow: var(--shadow); display: flex; flex-direction: column; justify-content: space-between;"
        >
          <div>
            <span class="section-eyebrow" style="color: var(--blue);">
              CIVIC INTELLIGENCE
            </span>
            <h3 style="font-size: 20px; font-weight: 800; margin: 8px 0 10px; font-family: var(--font-serif); color: var(--ink);">
              Explore Our Work
            </h3>
            <p style="font-size: 14.5px; color: var(--muted); line-height: 1.55; margin: 0 0 20px;">
              "I want to understand what Nagrik Party is building."
              Inspect verified crime records, civic grievance tracking, topic monitors, and transparent financial ledgers.
            </p>
          </div>
          <div class="button" style="width: 100%; justify-content: center; min-height: 44px; color: var(--blue); border-color: var(--blue);">
            Open Civic Explorer <ArrowRight size={16} />
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: WHY ARE WE BUILDING THIS? (FOUNDER STORY)
       ========================================================================= -->
  <section class="section band-soft" style="border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="container" style="max-width: 820px;">
      <div class="section-eyebrow">
        FOUNDING PRINCIPLES
      </div>
      <h2 class="section-title" style="margin: 6px 0 18px;">
        Why are we building this?
      </h2>

      <div style="font-size: 16px; line-height: 1.7; color: var(--ink-body); display: grid; gap: 16px;">
        <p>
          Sheikh Arsalanullah Chishti contested the 2025 Delhi Legislative Assembly election independently in Okhla. The campaign revealed a clear truth: while an independent candidate can raise voice for a neighborhood, individual campaigns cannot permanently change how decisions are made.
        </p>

        <p>
          Coming from a family where both parents served as government teachers, the everyday reality of public work is unmistakable. Honest public service, education, and years of duty do not automatically guarantee security in later life.
        </p>

        <blockquote
          style="margin: 12px 0; padding: 18px 22px; background: var(--paper-card); border-left: 3px solid var(--saffron); border-radius: 2px; font-family: var(--font-serif); font-size: 17.5px; color: var(--ink); line-height: 1.55; border-top: 1px solid var(--line); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);"
        >
          "If people can spend their lives serving society and still feel insecure about healthcare, inflation and everyday life, what future are we building?"
        </blockquote>

        <p>
          We do not believe in complaining about other political parties. Our focus is straightforward:
          <strong>We are trying to build an organisation that works.</strong>
        </p>

        <p style="font-weight: 600; color: var(--ink); font-size: 17px;">
          The goal isn't to complain about what is broken. The goal is to build what should work.
        </p>
      </div>

      <div style="margin-top: 24px;">
        <a href="/why-nagrik" class="button" style="font-size: 14.5px; font-weight: 600; min-height: 44px;">
          Read the Full Story & Principles &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: FROM VOTER TO PARTICIPANT (CIVIC LIFECYCLE)
       ========================================================================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" style="margin-bottom: 32px; text-align: center;">
        <div class="section-eyebrow">Operating Doctrine</div>
        <h2 class="section-title">
          From voter to participant.
        </h2>
        <p class="section-desc" style="margin: 0 auto;">
          How a citizen grievance moves through verification and becomes an official policy priority.
        </p>
      </div>

      <div class="lifecycle-grid">
        <div class="card" style="background: var(--paper-card); padding: clamp(18px, 3vw, 24px); border-radius: 4px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 3px; background: var(--ink); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); margin-bottom: 14px; font-size: 13px;">
            1
          </div>
          <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 8px; font-family: var(--font-serif); color: var(--ink);">Citizen Reports Issue</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">
            Report a local water, road, sanitation or lighting hazard. Complainant identity is strictly protected.
          </p>
        </div>

        <div class="card" style="background: var(--paper-card); padding: clamp(18px, 3vw, 24px); border-radius: 4px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 3px; background: var(--saffron); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); margin-bottom: 14px; font-size: 13px;">
            2
          </div>
          <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 8px; font-family: var(--font-serif); color: var(--ink);">Volunteer Verifies</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">
            A local ward coordinator performs a physical ground check to confirm the problem and location.
          </p>
        </div>

        <div class="card" style="background: var(--paper-card); padding: clamp(18px, 3vw, 24px); border-radius: 4px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 3px; background: var(--blue); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); margin-bottom: 14px; font-size: 13px;">
            3
          </div>
          <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 8px; font-family: var(--font-serif); color: var(--ink);">Lawful Submission</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">
            Escalation to PWD, MCD, or Delhi Jal Board with tracked complaint IDs and response logs.
          </p>
        </div>

        <div class="card" style="background: var(--paper-card); padding: clamp(18px, 3vw, 24px); border-radius: 4px; border: 1px solid var(--line);">
          <div style="width: 32px; height: 32px; border-radius: 3px; background: var(--green); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-mono); margin-bottom: 14px; font-size: 13px;">
            4
          </div>
          <h3 style="font-size: 16px; font-weight: 700; margin: 0 0 8px; font-family: var(--font-serif); color: var(--ink);">Manifesto Commitment</h3>
          <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0;">
            Unresolved civic neglect is codified into our binding constituency priorities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 6: FORMATION PROGRESS (LIVE PERCENTAGE)
       ========================================================================= -->
  <section class="section band-soft" style="border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div>
          <div class="section-eyebrow">
            Statutory Milestone Audit
          </div>
          <h2 class="section-title">
            Formation Progress: {progressData.percentage}%
          </h2>
          <p class="section-desc">
            Weighted calculation across Phase 1 foundation, membership, organisation, and compliance milestones.
          </p>
        </div>
        <a href="/formation-progress" class="button" style="font-size: 13.5px; font-weight: 600; min-height: 42px;">
          Inspect 9-Stage Roadmap &rarr;
        </a>
      </div>

      <div style="background: var(--paper-card); border: 1px solid var(--line-strong); border-radius: 4px; padding: clamp(18px, 3vw, 26px); box-shadow: var(--shadow);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font-size: 13px; flex-wrap: wrap; gap: 6px;">
          <span style="font-weight: 600; color: var(--ink);">
            Phase 1 Completion ({progressData.completedCount} of {progressData.totalMilestones} Milestones Completed)
          </span>
          <span style="font-family: var(--font-mono); font-weight: 800; color: var(--saffron); font-size: 14px;">
            {progressData.percentage}%
          </span>
        </div>
        <div style="width: 100%; height: 8px; background: var(--paper-subtle); border-radius: 4px; overflow: hidden; border: 1px solid var(--line); margin-bottom: 20px;">
          <div style={`width: ${progressData.percentage}%; height: 100%; background: var(--saffron); border-radius: 3px;`} />
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
          {progressData.milestones.slice(0, 3).map((m) => (
            <div style="background: var(--paper-subtle); border: 1px solid var(--line); border-radius: 3px; padding: 14px 16px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <span style="font-size: 11px; font-weight: 700; font-family: var(--font-mono); color: var(--muted); text-transform: uppercase;">
                  {m.category}
                </span>
                <span
                  style={{
                    fontSize: "11px",
                    fontWeight: 700,
                    color: m.status === "COMPLETED" ? "var(--green)" : m.status === "IN_PROGRESS" ? "var(--saffron)" : "var(--muted)",
                  }}
                >
                  {m.status === "COMPLETED" ? "Completed" : m.status === "IN_PROGRESS" ? "In Progress" : "Upcoming"}
                </span>
              </div>
              <strong style="font-size: 14px; color: var(--ink); display: block; line-height: 1.4;">{m.title}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 7: WHAT ARE WE BUILDING? (PUBLIC OUTCOMES)
       ========================================================================= -->
  <section class="section">
    <div class="container">
      <div class="section-head" style="margin-bottom: 32px; text-align: center;">
        <div class="section-eyebrow">Substantive Goals</div>
        <h2 class="section-title">
          What are we building?
        </h2>
        <p class="section-desc" style="margin: 0 auto;">
          A focus on tangible civic outcomes that protect ordinary families and uphold human dignity.
        </p>
      </div>

      <div class="outcomes-grid">
        {FOUNDER_DATA.publicOutcomes.map((item) => (
          <div class="card" style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: clamp(18px, 2.5vw, 22px); box-shadow: var(--shadow);">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
              <CheckCircle2 size={16} style={{ color: "var(--green)", flexShrink: 0 }} />
              <h3 style="font-size: 15.5px; font-weight: 700; margin: 0; font-family: var(--font-serif); color: var(--ink);">
                {item.title}
              </h3>
            </div>
            <p style="font-size: 13.5px; color: var(--muted); line-height: 1.55; margin: 0;">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 8: EXPLORE (CIVIC ISSUES, CRIME, TOPIC TRACKER)
       ========================================================================= -->
  <section class="section band-soft" id="explore" style="border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
        <div>
          <div class="section-eyebrow" style="color: var(--blue);">
            Civic Accountability & Evidence
          </div>
          <h2 class="section-title">
            Explore Public Evidence
          </h2>
          <p class="section-desc">
            Documented civic issues, verified crime citations, and news topic monitors across Delhi NCR.
          </p>
        </div>
        <a href="/explore" class="button" style="font-size: 13.5px; font-weight: 600; min-height: 44px;">
          Open Complete Explorer &rarr;
        </a>
      </div>

      <div class="cards-grid-3">
        
        <div class="card" style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: clamp(20px, 3vw, 26px); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
              <ShieldAlert size={18} style={{ color: "var(--red)" }} />
              <h3 style="font-size: 17px; font-weight: 700; margin: 0; font-family: var(--font-serif); color: var(--ink);">
                Verified Crime Tracker
              </h3>
            </div>
            <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0 0 16px;">
              Every documented offense is verified against published news reports. No invented claims.
            </p>
          </div>
          <a href="/crime" class="button" style="width: 100%; justify-content: center; min-height: 44px; color: var(--red); border-color: var(--red); font-size: 13.5px; font-weight: 600;">
            Search Crime Records &rarr;
          </a>
        </div>

        <div class="card" style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: clamp(20px, 3vw, 26px); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
              <AlertCircle size={18} style={{ color: "var(--saffron)" }} />
              <h3 style="font-size: 17px; font-weight: 700; margin: 0; font-family: var(--font-serif); color: var(--ink);">
                Civic Issues Registry
              </h3>
            </div>
            <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0 0 16px;">
              Local problems filed by citizens across Delhi ACs with municipal complaint tracking.
            </p>
          </div>
          <a href="/issues" class="button" style="width: 100%; justify-content: center; min-height: 44px; color: var(--saffron); border-color: var(--saffron); font-size: 13.5px; font-weight: 600;">
            Browse Issues &rarr;
          </a>
        </div>

        <div class="card" style="background: var(--paper-card); border: 1px solid var(--line); border-radius: 4px; padding: clamp(20px, 3vw, 26px); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
              <TrendingUp size={18} style={{ color: "var(--blue)" }} />
              <h3 style="font-size: 17px; font-weight: 700; margin: 0; font-family: var(--font-serif); color: var(--ink);">
                Topic Tracker
              </h3>
            </div>
            <p style="font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0 0 16px;">
              Air pollution, garbage, roads, water supply, and public services tracked with source provenance.
            </p>
          </div>
          <a href="/explore#topics" class="button" style="width: 100%; justify-content: center; min-height: 42px; color: var(--blue); border-color: var(--blue); font-size: 13.5px; font-weight: 600;">
            View Topic Monitors &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 9: BUILD WITH US
       ========================================================================= -->
  <section class="section">
    <div class="container">
      <div
        class="card"
        style="background: var(--paper-card); border: 1px solid var(--line-strong); border-radius: 4px; padding: clamp(24px, 4vw, 40px); box-shadow: var(--shadow-elevated);"
      >
        <div style="max-width: 700px; margin-bottom: 24px;">
          <div class="section-eyebrow">
            Participate
          </div>
          <h2 class="section-title" style="font-size: clamp(22px, 3.5vw, 34px);">
