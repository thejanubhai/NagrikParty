  <!-- =========================================================================
       SECTION 11: FORMATION ROADMAP
       ========================================================================= -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <div class="section-head" style="margin-bottom: 28px; text-align: center;">
        <div class="section-eyebrow">Roadmap</div>
        <h2 class="section-title">
          The 9-Stage Formation Journey
        </h2>
        <p class="section-desc" style="margin: 0 auto;">
          Auditable progress toward registration under Section 29A RPA 1951.
        </p>
      </div>

      <div style="display: grid; gap: 12px;">
        {progressData.milestones.slice(0, 5).map((st) => (
          <div
            class={`roadmap-item-card ${st.status === "IN_PROGRESS" ? "is-active" : ""}`}
          >
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                <span
                  style={{
                    fontFamily: "var(--font-mono)",
                    fontSize: "11px",
                    fontWeight: 700,
                    padding: "2px 8px",
                    borderRadius: "2px",
                    background: st.status === "COMPLETED" ? "rgba(29, 86, 53, 0.1)" : st.status === "IN_PROGRESS" ? "rgba(179, 74, 21, 0.1)" : "var(--paper-subtle)",
                    color: st.status === "COMPLETED" ? "var(--green)" : st.status === "IN_PROGRESS" ? "var(--saffron)" : "var(--muted)",
                  }}
                >
                  Stage {st.sort_order}
                </span>
                <span style="font-size: 11.5px; color: var(--muted); font-family: var(--font-mono); text-transform: uppercase;">
                  {st.category}
                </span>
              </div>
              <h3 style="font-size: 15.5px; font-weight: 700; margin: 0; color: var(--ink); line-height: 1.4;">
                {st.title}
              </h3>
            </div>

            <div style={{
              fontSize: "13px",
              fontWeight: 700,
              color: st.status === "COMPLETED" ? "var(--green)" : st.status === "IN_PROGRESS" ? "var(--saffron)" : "var(--muted)",
              whiteSpace: "nowrap",
            }}>
              {st.status === "COMPLETED" ? "Completed" : st.status === "IN_PROGRESS" ? "Active Stage" : "Upcoming"}
            </div>
          </div>
        ))}
      </div>

      <div style="text-align: center; margin-top: 24px;">
        <a href="/formation-progress" class="button" style="font-size: 14px; font-weight: 600; min-height: 44px;">
          View Full 9-Stage Roadmap &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 12: FINAL CTA
       ========================================================================= -->
  <section class="section" style="background: var(--paper-card); border-top: 1px solid var(--line-strong);">
    <div class="container" style="max-width: 800px; text-align: center;">
      <div class="section-eyebrow" style="margin-bottom: 12px;">
