---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CrimeFeed } from "@/components/CrimeFeed";

export const prerender = false;

const { type } = Astro.params;
if (!type) {
  return Astro.redirect('/crime');
}

const fallbackType = type.charAt(0).toUpperCase() + type.slice(1).toLowerCase();

import { supabase } from "@/lib/supabase";

// Fetch data directly from DB to avoid SSR fetch issues
const { data: rawIncidents } = supabase 
  ? await supabase
      .from('crimes')
      .select('id, crime_type, title, source_url, incident_date')
      .ilike('crime_type', type)
      .order('incident_date', { ascending: false })
  : { data: [] };
// Title guard: blank title kabhi render mat karo
const incidents = (rawIncidents ?? []).map((c: { id: string; title?: string | null; source_url: string; incident_date: string; crime_type: string }) => ({
  id: c.id,
  title: c.title && c.title.trim().length > 0 ? c.title : `Verified ${c.crime_type} incident, Delhi NCR`,
  source_url: c.source_url,
  incident_date: c.incident_date,
  crime_type: c.crime_type,
}));
const dbType = incidents.length > 0 ? incidents[0].crime_type : fallbackType;
---

<BaseLayout
  title={`Nagrik Party | ${dbType} Citations`}
  description={`Verified news citations for reported ${dbType} incidents in Delhi.`}
>
  <section class="page-hero" style="padding-bottom: 24px;">
    <div class="container" style="max-width: 900px;">
      <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
        <a href="/crime" style="display: inline-flex; align-items: center; gap: 4px; font-size: 13px; color: var(--muted); text-decoration: none; font-weight: 600;">
          &larr; Verified Crime Tracker
        </a>
      </div>

      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 8px; flex-wrap: wrap;">
        <h1 style="margin: 0; font-size: 28px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-family: var(--font-serif);">
          {dbType}
        </h1>
        <span class="badge-verified" style="border-radius: 2px; border: 1px dashed var(--red);">
          {incidents.length} Verified Citations
        </span>
      </div>

      <p class="page-copy" style="margin: 0;">
        Every incident listed below is verified and directly linked to a public news article or official report. Zero statistical estimates.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 12px; min-height: 60vh;">
    <div class="container" style="max-width: 900px;">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        {incidents.length === 0 ? (
          <div class="card" style="text-align: center; padding: 48px 24px; background: var(--paper-card); border-radius: 4px; border: 1px dashed var(--line); box-shadow: var(--shadow);">
            <p style="color: var(--muted); margin: 0; font-size: 14px;">No verified citations found for this category yet.</p>
          </div>
        ) : (
          <CrimeFeed client:visible items={incidents} />
        )}
      </div>
    </div>
  </section>
</BaseLayout>
