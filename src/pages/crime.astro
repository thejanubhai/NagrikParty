---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabase";
import { ShieldAlert, CheckCircle2, ChevronRight, Info } from "lucide-react";
import { CrimeFeed } from "@/components/CrimeFeed";

export const prerender = false;

// Fetch stats and recent verified crimes
let stats: Array<{ crime_type: string; count: number }> = [];
let recentCrimes: Array<{ id: string; title: string; source_url: string; incident_date: string; crime_type: string }> = [];

const defaultCategories = ["Rape", "Murder", "Kidnapping", "Robbery", "Extortion"];

if (supabase) {
  try {
    const { data: allCrimes } = await supabase
      .from("crimes")
      .select("id, crime_type, title, source_url, incident_date")
      .order("incident_date", { ascending: false });

    if (allCrimes) {
      const counts: Record<string, number> = {};
      allCrimes.forEach((c: { crime_type: string }) => {
        counts[c.crime_type] = (counts[c.crime_type] || 0) + 1;
      });

      stats = defaultCategories.map((type) => ({
        crime_type: type,
        count: counts[type] || 0,
      }));

      // Add other detected types
      Object.keys(counts).forEach((k) => {
        if (!defaultCategories.includes(k)) {
          stats.push({ crime_type: k, count: counts[k] });
        }
      });

      // Title guard: blank titles ko readable fallback do taaki feed me kabhi khaali card na dikhe
      recentCrimes = allCrimes.slice(0, 50).map((c: { id: string; title?: string | null; source_url: string; incident_date: string; crime_type: string }) => ({
        id: c.id,
        title: c.title && c.title.trim().length > 0 ? c.title : `Verified ${c.crime_type} incident, Delhi NCR`,
        source_url: c.source_url,
        incident_date: c.incident_date,
        crime_type: c.crime_type,
      }));
    }
  } catch (e) {
    console.error("Error fetching crime records:", e);
  }
}

const totalCitations = stats.reduce((acc, curr) => acc + curr.count, 0);
---

<BaseLayout
  title="Verified Crime Tracker | Nagrik Party"
  description="Publicly documented crime citations in Delhi NCR, verified and linked directly to published sources. Zero statistical guesswork."
>
  <section class="page-hero" style="padding-bottom: 32px;">
    <div class="container">
      <div class="civic-hero-badge">
        <ShieldAlert size={14} color="#c45500" />
        Civic Evidence & Public Accountability
      </div>
      <h1>Verified Crime Tracker</h1>
      <p class="page-copy" style="max-width: 760px;">
        Delhi NCR ki publicly documented crime jaankari. Har incident verified aur seedha news source se juda hua. Koi andaza nahi, sirf saboot.
      </p>

      <div style="display: flex; gap: 12px; margin-top: 18px; flex-wrap: wrap; align-items: center;">
        <span class="badge-verified">
          <CheckCircle2 size={13} /> {totalCitations} Verified Citations Active
        </span>
        <span class="badge-citation">
          Coverage: Delhi NCR
        </span>
        <span class="badge-citation">
          Source: Verified News & Police Reports
        </span>
      </div>

      <!-- Category filter chips (large touch targets) -->
      <div class="filter-chips" style="margin-top: 20px;">
        <a href="/crime" class="filter-chip is-active">Sab</a>
        {defaultCategories.map((t) => (
          <a href={`/crimes/${t.toLowerCase()}`} class="filter-chip">{t}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 1060px;">
      
      <!-- Methodology & Accountability Notice -->
      <div class="card" style="background: var(--paper-card); border: 1px solid var(--line-strong); border-left: 3px solid var(--saffron); border-radius: 3px; padding: 18px 22px; margin-bottom: 28px; display: flex; gap: 14px; align-items: flex-start; box-shadow: var(--shadow);">
        <Info size={20} style={{ color: "var(--saffron)", flexShrink: 0, marginTop: "2px" }} />
        <div>
          <strong style="font-size: 14.5px; color: var(--ink); font-family: var(--font-serif);">Civic Methodology & Evidence Standard</strong>
          <p style="font-size: 13px; color: var(--muted); margin: 4px 0 0; line-height: 1.6;">
            The Nagrik Party Verified Crime Tracker indexes public evidence of serious offenses across the National Capital Region.
            Citations are automatically ingested from reputable national news providers and monitored for veracity.
            Each item represents a documented, published event with a verifiable link.
          </p>
        </div>
      </div>

      <!-- Categories Summary Grid -->
      <div style="margin-bottom: 36px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
          <div>
            <h2 style="font-size: 20px; font-weight: 700; margin: 0; font-family: var(--font-serif);">Category Breakdown</h2>
            <p style="font-size: 13px; color: var(--muted); margin: 2px 0 0;">Select a category to view all verified news records.</p>
          </div>
          <a href="/issues" class="button" style="font-size: 13px; padding: 10px 18px; min-height: 44px; display: inline-flex; align-items: center;">
            Report Unlisted Incident
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
          {stats.map((st) => (
            <a href={`/crimes/${st.crime_type.toLowerCase()}`} class="crime-hero-stat-card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12.5px; font-weight: 700; color: var(--ink); text-transform: uppercase; letter-spacing: 0.05em; font-family: var(--font-mono);">
                  {st.crime_type}
                </span>
                <span style="color: var(--red);">
                  <ChevronRight size={15} />
                </span>
              </div>
              <div style="font-size: 28px; font-weight: 700; color: var(--ink); font-family: var(--font-mono); line-height: 1;">
                {st.count}
              </div>
              <div style="font-size: 11px; color: var(--muted); margin-top: 6px;">
                Verified incidents &rarr;
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Recent Citations Feed -->
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid var(--line); padding-bottom: 12px;">
          <div>
            <h3 style="font-size: 18px; font-weight: 800; margin: 0;">Recent Verified Citations</h3>
            <span style="font-size: 13px; color: var(--muted);">Live audit feed of documented offenses</span>
          </div>
          <div style="font-size: 12px; color: var(--muted);">
            Showing latest {recentCrimes.length} records
          </div>
        </div>

        {recentCrimes.length === 0 ? (
          <div class="empty-state">
            <div class="empty-state-icon" aria-hidden="true">🛡️</div>
            <h3 class="empty-state-title">Abhi koi verified citation nahi hai</h3>
            <p class="empty-state-msg">Jaise hi verified records aayenge, yahan live feed dikhegi. Har record ka news source link hota hai.</p>
          </div>
        ) : (
          <CrimeFeed client:visible items={recentCrimes} />
        )}
      </div>

    </div>
  </section>
</BaseLayout>
