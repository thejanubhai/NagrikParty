audit=false
fund=false
update-notifier=false
prefer-offline=true
progress=false
# The registry publishes @playwright/test ahead of the matching playwright
# package, and @astrojs/check still declares a typescript peer of ^5 || ^6
# while this repo uses typescript 7. Both are upstream publishing quirks, so
# dependency resolution runs in legacy peer mode.
legacy-peer-deps=true

